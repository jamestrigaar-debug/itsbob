# Copy to .env and fill in what you have. Everything is optional: with no keys
# at all itsbob still runs, on the offline provider and keyword-only recall.
#
# .env is gitignored. Nothing here is ever sent to a model or written to the
# audit log — call_api attaches keys itself, so the assistant never sees them.

# --- models -----------------------------------------------------------------
# Google is the one that matters: a single key gives models at three genuinely
# different price points, which is what the tier ladder is built on.
GOOGLE_API_KEY=
# Optional backups, tried only after every Gemini model has failed.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- where everything lives -------------------------------------------------
# Memory, workspace, task list and audit log. Back this up; delete it to reset.
# ITSBOB_HOME=~/.itsbob
# ITSBOB_WORKSPACE=~/.itsbob/workspace

# --- what it may do ---------------------------------------------------------
# readonly | guarded (default) | dry_run | trusted
#   guarded: reads and workspace writes run; commands and network ask first,
#            and are refused outright when nobody is there to ask.
#   trusted: everything runs unattended except deleting things.
# ITSBOB_TOOL_MODE=guarded
# Tools that never need approval, even in guarded mode:
# ITSBOB_AUTO_ALLOW=run_shell,http_request
# Tools that always need it, even in trusted mode:
# ITSBOB_ALWAYS_CONFIRM=delete_file
# Tools that never run at all:
# ITSBOB_BLOCKED_TOOLS=
# Restrict outbound requests to these hosts (empty means any):
# ITSBOB_ALLOWED_HOSTS=api.github.com,api.openweathermap.org
# Seconds any single command may run:
# ITSBOB_TOOL_TIMEOUT=60

# --- memory -----------------------------------------------------------------
# ITSBOB_EMBED_MODEL=gemini-embedding-2
# ITSBOB_EMBED_DIMS=768
# Keep every memory on this machine (recall degrades to keyword + hashing):
# ITSBOB_EMBED_OFFLINE=false

# --- the local model (optional; free, private, preferred for Tier C) ---------
# ITSBOB_OLLAMA_URL=http://127.0.0.1:11434
# ITSBOB_OLLAMA_MODEL=qwen2.5:1.5b

# --- pin a model per tier ---------------------------------------------------
# Five rungs, cheapest first. Each is a real price and latency step, so the
# classifier picking the right one is where most of the cost is decided.
# ITSBOB_TIER_C_MODEL=gemini-3.5-flash-lite      # greetings, recall, chit-chat
# ITSBOB_TIER_B_MODEL=gemini-flash-lite-latest   # short answers, one obvious step
# ITSBOB_TIER_A_MODEL=gemini-3.5-flash           # real multi-step work, tools
# ITSBOB_TIER_S_MODEL=gemini-pro-latest          # judgement, anything hard to undo

# --- what the foundation scripts may clean ----------------------------------
# file_cleaner only ever touches the workspace plus these. Never your whole
# home directory, and never itsbob's own state.
# ITSBOB_CLEAN_ROOTS=~/Downloads:~/tmp

# --- the daemon -------------------------------------------------------------
# Where notifications go, in addition to the desktop and notifications.jsonl:
# ITSBOB_WEBHOOK_URL=

# --- APIs it may call -------------------------------------------------------
# Either apis.json (see README) or one block of these per API:
# ITSBOB_API_WEATHER_BASE=https://api.openweathermap.org/data/2.5
# ITSBOB_API_WEATHER_KEY_ENV=OPENWEATHER_KEY
# ITSBOB_API_WEATHER_AUTH=query
# ITSBOB_API_WEATHER_QUERY_PARAM=appid
# ITSBOB_API_WEATHER_DESCRIPTION=Current conditions and forecast by city.
# OPENWEATHER_KEY=
