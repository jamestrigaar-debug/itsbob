# Copy to .env and fill in whichever free-tier keys you have.
# All are optional — with none set, itsbob falls back to the offline
# EchoProvider and still runs end to end.

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional tuning — see README.md for the full list.
# ITSBOB_PROVIDER_ORDER=groq,google,openrouter
# ITSBOB_MEMORY_DB=data/memory.sqlite
# ITSBOB_SEED=1
